<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_background"
    android:backgroundTint="#E6DEDE"
    tools:context=".Registrate">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="105dp"
        android:layout_height="92dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toStartOf="@+id/textView3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/moe" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="194dp"
        android:layout_height="77dp"
        android:layout_marginEnd="61dp"
        android:layout_marginBottom="19dp"
        android:text="Textflow"
        android:textAlignment="center"
        android:textSize="50sp"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tx_info"
        android:layout_width="343dp"
        android:layout_height="38dp"
        android:layout_marginStart="43dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-black"
        android:text="Organiza tus tareas personales y profesionaeles"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/textView6"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_usuario"
        android:layout_width="335dp"
        android:layout_height="54dp"
        android:layout_marginStart="43dp"
        android:layout_marginBottom="22dp"
        android:background="@android:drawable/editbox_background_normal"
        android:ems="10"
        android:hint="Ej : Carlos"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/textView7"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_contrasena"
        android:layout_width="330dp"
        android:layout_height="54dp"
        android:layout_marginStart="42dp"
        android:layout_marginBottom="17dp"
        android:background="@android:drawable/editbox_background_normal"
        android:ems="10"
        android:hint="Ej : Casa2026"
        android:inputType="textPassword"
        app:layout_constraintBottom_toTopOf="@+id/textView8"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginBottom="15dp"
        android:text="Contraseña"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/et_contrasena"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_contrasenacopy"
        android:layout_width="330dp"
        android:layout_height="54dp"
        android:layout_marginStart="43dp"
        android:layout_marginBottom="24dp"
        android:background="@android:drawable/editbox_background_normal"
        android:ems="10"
        android:hint="Ej : Casa2026"
        android:inputType="textPassword"
        app:layout_constraintBottom_toTopOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="43dp"
        android:layout_marginBottom="14dp"
        android:text="Repite Contraseña"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/et_contrasenacopy"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="43dp"
        android:layout_marginBottom="11dp"
        android:text="Nombre Usuario"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/et_usuario"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="12dp"
        android:text="Crea tu Cuenta"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@+id/tx_info"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button2"
        android:layout_width="175dp"
        android:layout_height="65dp"
        android:layout_marginStart="118dp"
        android:layout_marginBottom="20dp"
        android:onClick="registrarse"
        android:text="Registrate"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/textView9"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="161dp"
        android:layout_height="64dp"
        android:layout_marginStart="156dp"
        android:layout_marginBottom="15dp"
        android:onClick="salir"
        android:text="Ya tengo Cuenta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>