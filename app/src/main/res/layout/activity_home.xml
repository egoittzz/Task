<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDD7DE"
    tools:context=".Home">

    <TextView
        android:id="@+id/textView14"
        android:layout_width="155dp"
        android:layout_height="133dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="32dp"
        android:background="#D7A9EF"
        android:textCursorDrawable="@color/design_default_color_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="155dp"
        android:layout_height="133dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="96dp"
        android:background="#D7A9EF"
        app:circularflow_radiusInDP="300sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Txt_completados"
        android:layout_width="85dp"
        android:layout_height="70dp"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="64dp"
        android:text="completados"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Txt_restantes"
        android:layout_width="85dp"
        android:layout_height="70dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="112dp"
        android:text="restantes"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView16"
        android:layout_width="124dp"
        android:layout_height="27dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="20dp"
        android:text="Tareas restantes"
        android:textAlignment="center"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Txt_restantes" />

    <TextView
        android:id="@+id/textView18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="50dp"
        android:text="Tareas completadas"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Txt_completados" />

    <ListView
        android:id="@+id/lt_tareas"
        android:layout_width="364dp"
        android:layout_height="255dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13">


    </ListView>

    <Button
        android:id="@+id/bt_nuevaTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="32dp"
        android:onClick="nueva_Tarea"
        android:text="Nueva Tarea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="49dp"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/moe" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="79dp"
        android:layout_height="23dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="Bienvenido"
        app:layout_constraintStart_toEndOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Txt_usu_bienvenida"
        android:layout_width="100dp"
        android:layout_height="34dp"
        android:layout_marginStart="68dp"
        android:layout_marginTop="4dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10" />

    <Spinner
        android:id="@+id/Spinner_cat"
        android:layout_width="314dp"
        android:layout_height="49dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13" />

    <TextView
        android:id="@+id/textView22"
        android:layout_width="158dp"
        android:layout_height="24dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="16dp"
        android:text="Categorias de filtardo"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView14" />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="64dp"
        android:onClick="listartareas"
        android:text="Filtrar por Categoria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lt_tareas" />

    <Button
        android:id="@+id/button4"
        android:layout_width="183dp"
        android:layout_height="49dp"
        android:layout_marginTop="320dp"
        android:layout_marginEnd="16dp"
        android:onClick="salir"
        android:text="Salir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lt_tareas" />

    <Button
        android:id="@+id/button6"
        android:layout_width="165dp"
        android:layout_height="48dp"
        android:layout_marginStart="124dp"
        android:layout_marginBottom="10dp"
        android:text="Eliminar"
        app:layout_constraintBottom_toTopOf="@+id/button4"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>