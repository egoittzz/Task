<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7CBD5"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="283dp"
        android:layout_marginEnd="90dp"
        android:text="Gestiona tus tareas de forma simple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="145dp"
        android:layout_height="131dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/gemini_generated_image_cbpdtocbpdtocbpd_removebg_preview" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="9dp"
        android:text="Inicia Sesion"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/et_usu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/et_usu"
        android:layout_width="297dp"
        android:layout_height="57dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="28dp"
        android:background="@android:drawable/editbox_background_normal"
        android:ems="10"
        android:focusableInTouchMode="true"
        android:hint="Usuario"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/et_con"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/et_con"
        android:layout_width="297dp"
        android:layout_height="57dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"
        android:background="@android:drawable/editbox_background_normal"
        android:ems="10"
        android:hint="Contraseña"
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_usu" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="134dp"
        android:layout_height="58dp"
        android:layout_marginStart="148dp"
        android:layout_marginTop="16dp"
        android:onClick="registrarse"
        android:text="Registrate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Tx_pregunta" />

    <Button
        android:id="@+id/button"
        android:layout_width="175dp"
        android:layout_height="56dp"
        android:layout_marginStart="96dp"
        android:layout_marginTop="20dp"
        android:onClick="iniciar_sesion"
        android:text="Iniciar Sesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_con" />

    <TextView
        android:id="@+id/Tx_pregunta"
        android:layout_width="154dp"
        android:layout_height="29dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="7dp"
        android:text="¿ No tienes cuenta ?"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/textView5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button" />

    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="388dp"
        android:layout_height="300dp"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/et_usu"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/image_removebg_preview__1_" />

</androidx.constraintlayout.widget.ConstraintLayout>